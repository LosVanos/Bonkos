rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Retrato de cada jogador: todos leem, só o próprio escreve
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['name','key','tier','up','rel','prest','cos','trophies','best','power','level','wins','losses','defW','defL','mast','ts'])
                   && request.resource.data.name is string && request.resource.data.name.size() <= 16;
    }
    // Registo de ataques: todos leem (para as defesas), só o atacante escreve o seu
    match /atk/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Transferir progresso: o código é o segredo; só o dono original pode reescrever
    match /saves/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid && code.size() == 8;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
